<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25.0.2"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cooperpay.controller.LojasFxController"
      spacing="12"
      prefWidth="1200"
      prefHeight="600"
      style="-fx-padding: 20;">

    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 0 8 0;">
        <Button text="Home" onAction="#voltarHome" />
        <Button text="Lojas" />
        <Button text="Sair" onAction="#sair" />
    </HBox>

    <Label text="Lojas"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtPesquisaMotoboy" promptText="Pesquisar motoboy..." prefWidth="420" />
        <Button text="Todas as lojas" onAction="#mostrarTodasAsLojas" />
        <MenuButton fx:id="menuLojas" text="Lojas" />
        <TextField fx:id="txtNovaLoja" promptText="Nova loja..." prefWidth="220" />
        <Button text="Criar loja" onAction="#criarLoja" />
        <TextField fx:id="txtIdLojaExcluir" promptText="ID loja..." prefWidth="120" />
        <Button text="Deletar loja" onAction="#deletarLoja" />
    </HBox>

    <Label fx:id="lblLojaSelecionada" text="Loja selecionada: nenhuma" />

    <TableView fx:id="tabelaMotoboysLoja" prefHeight="460" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNome" text="Nome" prefWidth="360" />
            <TableColumn fx:id="colPix" text="Pix" prefWidth="320" />
            <TableColumn fx:id="colLojaId" text="ID da Loja" prefWidth="140" />
            <TableColumn fx:id="colAlterarLoja" text="Vincular Loja" prefWidth="220" />
        </columns>
    </TableView>

    <Label fx:id="lblMensagem" style="-fx-text-fill: #444;" />

</VBox>
